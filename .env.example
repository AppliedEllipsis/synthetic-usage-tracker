# ==========================================
# Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)
#
# IMPORTANT: This project uses VSCode's SecretStorage for API keys
# The extension stores API keys securely in VSCode's encrypted storage
# This .env file is primarily for development and testing purposes
#
# ==========================================
# API Configuration
# ==========================================
# Synthetic.new API endpoint (optional - defaults to https://api.synthetic.new/v2)
SYNTHETIC_API_ENDPOINT=https://api.synthetic.new/v2

# ==========================================
# Development & Testing
# ==========================================
# Test API key for development (optional)
# For production use, the extension stores keys in VSCode SecretStorage
# This key is used by test-endpoint scripts (test-usage-endpoint.js, test-models-endpoint.js, etc.)
SYNTHETIC_API_KEY=your_api_key_here

# Test API key specifically for test-all-endpoints.js (takes precedence over SYNTHETIC_API_KEY)
# This is used by the comprehensive test suite that tests multiple endpoints
SYNTHETIC_TEST_API_KEY=your_api_key_here

# Enable debug logging (optional)
SYNTHETIC_DEBUG=false

# ==========================================
# Testing Configuration
# ==========================================
# Test environment (development/staging/production)
SYNTHETIC_ENV=development

# Timeout for API requests in milliseconds (optional)
SYNTHETIC_TIMEOUT=30000

# ==========================================
# Monitoring & Analytics
# ==========================================
# Enable usage analytics (optional)
SYNTHETIC_ANALYTICS=false

# ==========================================
# Notes
# ==========================================
# 1. This file is used as a template. Do NOT store actual secrets here.
# 2. Copy this file to .env and add your actual values for local development.
# 3. The extension uses VSCode's SecretStorage for secure API key storage.
# 4. Never commit .env files containing real credentials to version control.
# 5. For production use, configure API keys through the extension's settings UI.
